#include "ui/menudef.h"

{
  assetGlobalDef {
	font "fonts/font" 16
	smallFont "fonts/smallfont" 12
	bigFont "fonts/bigfont" 20
	cursor "ui/assets/3_cursor3"
	gradientBar "ui/assets/gradientbar2.tga"
	itemFocusSound "sound/misc/menu2.wav"
	fadeClamp 1.0
	fadeCycle 1
	fadeAmount 0.1
	shadowColor 0.1 0.1 0.1 0.25
  }

menuDef {
	name "main"
	fullScreen 1
	rect 0 0 640 480
	visible 1
	focusColor 1 .75 0 1
	style 1
	backcolor 0 0 0 1
	onESC { open quit_popmenu }

itemDef {
	name title
	type 1
	text "ReQoning Wave Arena"
	style 0
	textstyle 6
	rect 0 36 640 36
	textalign 1
	textalignx 320
	textaligny 28
	textscale .45
	forecolor 1 1 1 1
	visible 1
	decoration
}

itemDef {
	name play
	type 1
	text "Single Player"
	style 1
	textstyle 6
	rect 70 110 150 36
	textalign 1
	textalignx 75
	textaligny 26
	textscale .28
	forecolor 1 1 1 1
	backcolor 0 0 .55 .85
	border 1
	bordercolor .5 .5 .5 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; close main ; open skirmish }
	mouseEnter { setcolor backcolor .75 0 0 .85 }
	mouseExit { setcolor backcolor 0 0 .55 .85 }
}

itemDef {
	name play
	type 1
	text "Multiplayer"
	style 1
	textstyle 6
	rect 245 110 150 36
	textalign 1
	textalignx 75
	textaligny 26
	textscale .28
	forecolor 1 1 1 1
	backcolor 0 0 .55 .85
	border 1
	bordercolor .5 .5 .5 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; close main ; open joinserver }
	mouseEnter { setcolor backcolor .75 0 0 .85 }
	mouseExit { setcolor backcolor 0 0 .55 .85 }
}

itemDef {
	name play
	type 1
	text "Start Server"
	style 1
	textstyle 6
	rect 420 110 150 36
	textalign 1
	textalignx 75
	textaligny 26
	textscale .28
	forecolor 1 1 1 1
	backcolor 0 0 .55 .85
	border 1
	bordercolor .5 .5 .5 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; close main ; open createserver }
	mouseEnter { setcolor backcolor .75 0 0 .85 }
	mouseExit { setcolor backcolor 0 0 .55 .85 }
}

itemDef {
	name options
	type 1
	text "Player"
	style 1
	textstyle 6
	rect 70 200 150 36
	textalign 1
	textalignx 75
	textaligny 26
	textscale .28
	forecolor 1 1 1 1
	backcolor 0 0 .55 .85
	border 1
	bordercolor .5 .5 .5 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; close main ; open player_menu }
	mouseEnter { setcolor backcolor .75 0 0 .85 }
	mouseExit { setcolor backcolor 0 0 .55 .85 }
}

itemDef {
	name options
	type 1
	text "Setup"
	style 1
	textstyle 6
	rect 245 200 150 36
	textalign 1
	textalignx 75
	textaligny 26
	textscale .28
	forecolor 1 1 1 1
	backcolor 0 0 .55 .85
	border 1
	bordercolor .5 .5 .5 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; close main ; open setup_menu ; open control_menu }
	mouseEnter { setcolor backcolor .75 0 0 .85 }
	mouseExit { setcolor backcolor 0 0 .55 .85 }
}

itemDef {
	name options
	type 1
	text "Demos"
	style 1
	textstyle 6
	rect 420 200 150 36
	textalign 1
	textalignx 75
	textaligny 26
	textscale .28
	forecolor 1 1 1 1
	backcolor 0 0 .55 .85
	border 1
	bordercolor .5 .5 .5 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; close main ; open demo }
	mouseEnter { setcolor backcolor .75 0 0 .85 }
	mouseExit { setcolor backcolor 0 0 .55 .85 }
}

itemDef {
	name quit
	type 1
	text "QUIT"
	style 1
	textstyle 6
	rect 220 300 200 40
	textalign 1
	textalignx 100
	textaligny 28
	textscale .35
	forecolor 1 1 1 1
	backcolor .45 0 0 .85
	border 1
	bordercolor .5 .5 .5 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; open quit_popmenu }
	mouseEnter { setcolor backcolor .75 0 0 .95 }
	mouseExit { setcolor backcolor .45 0 0 .85 }
}

itemDef {
	name copyright
	text "OrbitaL Software  based on Quake III Arena / Team Arena"
	type 1
	style 0
	textscale .22
	rect 0 430 640 30
	textalign 1
	textalignx 320
	textaligny 20
	forecolor .7 .7 .7 1
	visible 1
	decoration
}

}
}
